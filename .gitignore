# Secrets stay local; only blank configuration templates belong in Git.
.env
.env.*
!.env.example
!.env.production.example
!.env.local.example
# Operator attestations stay outside version control; examples remain inert.
*-authorization.json

# Local databases, uploads and runtime snapshots.
.local/
.demo/
*.sqlite3
*.sqlite3-*
media/
staticfiles/
*.log

# Installed dependencies and generated output.
.venv/
venv/
node_modules/
dist/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
coverage/
backups/
*.age
*.partial
*.key
deploy/.local/
htmlcov/
*.tsbuildinfo

# Editor and operating-system metadata.
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
