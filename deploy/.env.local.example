# Public configuration only. Copy to .env.local; do not run up before owner approval.
# Absolute path to operator-controlled secret files (see LOCAL.md).
LOCAL_SECRETS_DIR=
LOCAL_BACKEND_IMAGE=ishchi-backend:local
LOCAL_FRONTEND_IMAGE=ishchi-frontend:local
# Fixed host endpoints (not configurable here):
# work PG 127.0.0.1:55432 / ishchi_marketplace_local / ishchi_local_app
# test PG 127.0.0.1:55433 / ishchi_marketplace_sprint1_local / ishchi_local_test
# work Redis 127.0.0.1:56379 DB 0 / ishchi_local_app
# test Redis 127.0.0.1:56380 DB 0 / ishchi_local_test
