# Operator template: replace domain, paths and certificate paths before nginx -t.
# Backend must listen on loopback/private network only.
limit_req_zone $binary_remote_addr zone=ishchi_auth:10m rate=10r/m;
server {
    listen 80;
    server_name example.uz;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name example.uz;
    ssl_certificate /etc/ssl/ishchi/fullchain.pem;
    ssl_certificate_key /etc/ssl/ishchi/privkey.pem;
    client_max_body_size 6m;
    root /srv/ishchi/frontend/dist;

    # Never expose private attachments through static hosting.
    location ^~ /media/chat/ { return 404; }
    location /media/ {
        alias /srv/ishchi/backend/media/;
        add_header X-Content-Type-Options nosniff always;
        autoindex off;
    }
    location /static/ { alias /srv/ishchi/backend/staticfiles/; }
    location ~ ^/api/v1/auth/(register|login|otp/.*|password/reset/.*)/$ {
        limit_req zone=ishchi_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
    }
    location /api/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
    }
    location /django-admin/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
    location / { try_files $uri $uri/ /index.html; }
}
