# Local HTTP development (fresh SQLite; never uses root .env or PostgreSQL).
DJANGO_SETTINGS_MODULE=config.settings.development
ISHCHI_ENV=development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Registration sends no SMS. Optional verification/reset may use an HTTP provider.
# Explicit local Python outbox for tests: SMS_BACKEND=memory.
SMS_BACKEND=disabled
SMS_API_URL=
SMS_API_TOKEN=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
