# Inject via your hosting secret manager. Production does not read local .env.
DJANGO_SETTINGS_MODULE=config.settings.production
ISHCHI_ENV=production
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=example.uz
CSRF_TRUSTED_ORIGINS=https://example.uz
CORS_ALLOWED_ORIGINS=https://example.uz
TRUST_HTTPS_PROXY=false
TRUSTED_PROXY_IPS=127.0.0.1,::1
HEALTHCHECK_HOST=example.uz
DJANGO_MEDIA_ROOT=/app/media
WEB_WORKERS=2
WEB_THREADS=2
DB_NAME=ishchi_marketplace
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=5
# Exact-target operator approval; credentials alone never authorize a connection.
DB_AUTHORIZATION_FILE=
REDIS_URL=
REDIS_SSLROOTCERT=
REDIS_AUTHORIZATION_FILE=
REDIS_KEY_PREFIX=ishchi:production
# These local file variables do NOT unlock production access. Sprint 2 guards remain.
# Optional SMS verification/password recovery; registration sends no SMS.
SMS_BACKEND=disabled
SMS_API_URL=
SMS_API_TOKEN=
